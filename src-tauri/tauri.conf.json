{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "River Raid",
  "version": "0.1.0",
  "identifier": "dev.mrc.riverraid",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../builds/desktop",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "River Raid",
        "width": 960,
        "height": 720,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
