{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "River Raid",
  "version": "1.0.0",
  "identifier": "local.riverraid.lab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../builds/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "River Raid",
        "width": 480,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
